# ========================================================
# AUTOMATION WEBSERVICE BT - CONFIGURATION
# ========================================================

# Service Settings
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-to-a-secure-random-secret
# Optional: Shared secret required on every /api/v1 call, sent as the
# `X-API-Token` header. Leave EMPTY to leave the API open (fine for local use
# on 127.0.0.1). Set it to a long random value to lock the API down.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# When set, operators paste it into the "API Token" box on the dashboard.
#
# NOTE: leaving this empty leaves the *other* API open, but the surrender
# endpoints (POST /api/v1/surrenders) refuse to run at all until it is set, and
# answer 503. Service surrender destroys customer data, so it never runs
# unauthenticated. Set it before going anywhere near production.
API_AUTH_TOKEN=

# --------------------------------------------------------
# TLS
# --------------------------------------------------------
# Verify server certificates on every HTTPS call. All hosting and registry
# servers present publicly-trusted Let's Encrypt / Sectigo certificates, so
# this works. Set false only as a last resort; prefer TLS_CA_BUNDLE instead.
TLS_VERIFY=true
# Path to a CA bundle, if a server ever uses a private/internal CA.
TLS_CA_BUNDLE=

# --------------------------------------------------------
# CPANEL / WHM SERVER SETTINGS
# --------------------------------------------------------
# Server Hostname or IP
CPANEL_SERVER_HOST=cpanel.yourdomain.bt
# DNS name on the server certificate. REQUIRED for TLS verification when
# CPANEL_SERVER_HOST is an IP address, because the certificate carries DNS
# SANs only and hostname matching would otherwise fail. Leave blank if
# CPANEL_SERVER_HOST is already a hostname.
CPANEL_TLS_HOSTNAME=thimpchu.druknet.bt
# Web UI customer login URL (Port 2083 for cPanel SSL)
CPANEL_WEB_PORT=2083
CPANEL_WEB_URL=https://cpanel.yourdomain.bt:2083

# SSH Access (User has root or reseller SSH access)
CPANEL_SSH_PORT=22
CPANEL_SSH_USER=root
# Either specify SSH password or private key path
CPANEL_SSH_PASSWORD=
CPANEL_SSH_KEY_PATH=~/.ssh/id_rsa

# Optional: WHM REST API (Alternative or complement to SSH)
# WHM API Port is usually 2087
CPANEL_WHM_USER=root
CPANEL_WHM_API_TOKEN=

# Default Package / Plan in cPanel/WHM
CPANEL_DEFAULT_PLAN=default

# Customer SFTP Settings
CPANEL_SFTP_PORT=22
CPANEL_NAMESERVERS="ns1.yourdomain.bt, ns2.yourdomain.bt"

# --------------------------------------------------------
# DIRECTADMIN SERVER SETTINGS
# --------------------------------------------------------
# Server Hostname or IP
DIRECTADMIN_SERVER_HOST=da.yourdomain.bt
# DNS name on the server certificate (see CPANEL_TLS_HOSTNAME note above).
DIRECTADMIN_TLS_HOSTNAME=yongnay.druknet.bt
# Address DirectAdmin assigns to newly created accounts. Required: without it
# account creation fails rather than guessing an IP.
DIRECTADMIN_SERVER_IP=202.144.128.131
# Web UI customer login URL (Port 2222 for DirectAdmin)
DIRECTADMIN_WEB_PORT=2222
DIRECTADMIN_WEB_URL=https://da.yourdomain.bt:2222

# SSH Access (Admin or Reseller SSH access)
DIRECTADMIN_SSH_PORT=22
DIRECTADMIN_SSH_USER=root
DIRECTADMIN_SSH_PASSWORD=
DIRECTADMIN_SSH_KEY_PATH=~/.ssh/id_rsa

# Optional: DirectAdmin API (Admin username & password or login key)
DIRECTADMIN_API_USER=admin
DIRECTADMIN_API_PASSWORD=

# Default Package in DirectAdmin
DIRECTADMIN_DEFAULT_PACKAGE=default

# Customer SFTP Settings
DIRECTADMIN_SFTP_PORT=22
DIRECTADMIN_NAMESERVERS="ns1.yourdomain.bt, ns2.yourdomain.bt"

# --------------------------------------------------------
# NOTIFICATION / EMAIL SETTINGS (Optional: for sending welcome email directly)
# --------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Web Hosting Support"
SMTP_FROM_EMAIL=support@yourdomain.bt
SMTP_CC_EMAIL=systems@bt.bt

# --------------------------------------------------------
# NIC / WHOIS REGISTRY SETTINGS (nic.bt.bt)
# --------------------------------------------------------
NIC_ENABLED=true
NIC_URL=https://nic.bt.bt
NIC_USER=admin@bt.bt
NIC_PASSWORD=

# --------------------------------------------------------
# SERVICE SURRENDER (termination) SETTINGS
# --------------------------------------------------------
# Surrendering removes a hosting account and/or a domain registration. It is
# irreversible, so it is gated harder than account creation: see the note on
# API_AUTH_TOKEN above.
#
# The scanned surrender letter is stored here and a JSONL audit trail is kept
# alongside it. Both contain customer documents, so keep this directory off any
# web-served path and back it up. It is git-ignored.
SURRENDER_UPLOAD_DIR=./data/surrenders
SURRENDER_AUDIT_LOG=./data/surrenders/audit.jsonl

# Largest accepted evidence file, in MB. Uploads are capped while streaming, so
# an oversized file is never fully written to disk.
SURRENDER_MAX_UPLOAD_MB=10

# Require the scanned surrender letter. Turning this off removes the evidence
# requirement entirely, which weakens the audit trail -- only do it if your
# process does not produce a letter.
SURRENDER_REQUIRE_EVIDENCE=true

# Accepted evidence formats. A JPEG is allowed because the letter is often
# photographed. Uploads are also checked against these formats by content, not
# just by extension.
SURRENDER_ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg

# --------------------------------------------------------
# VALUES CONTAINING "$"  -- READ THIS
# --------------------------------------------------------
# Docker Compose treats "$NAME" inside a value as a variable reference and
# silently replaces it with an empty string. A password like "pa$word$x" would
# therefore reach the container as "pord" -- no error, just a wrong credential.
#
# To store a literal "$", double it: "$$". Compose turns "$$" back into "$",
# and config.py performs the same unescape for the host so the CLI and the
# container see identical values. This applies to any secret containing "$".
#
# Do NOT put quotes around values here. python-dotenv strips them, but Docker's
# env_file handling does not, so quoted values reach the container with the
# quote characters still attached -- which silently broke NIC_PASSWORD and
# SMTP_PASSWORD before.
#
# (Set the real values in the sections above; this block is guidance only.)

# --------------------------------------------------------
# ERICSSON BSCS / CBiO CX  (READ-ONLY reference)
# --------------------------------------------------------
# Lookup only. We hold NO rights to change contracts, VAS packages or billing
# state on this portal, so bscs_client.py deliberately implements no write
# operation. If a change is ever needed, it is made in the portal by an
# authorised operator -- not from here.
#
# Used to confirm a customer exists before provisioning, and to read their
# contract/billing state as reference.
#
# Reachability: the portal sits on the internal network (10.0.x.x), reached via
# the VPN tunnel on this host. The container reaches it too, but only while
# that tunnel is up.
BSCS_ENABLED=false
BSCS_BASE_URL=http://10.0.41.149:8581/custcare_cu
BSCS_USERNAME=
BSCS_PASSWORD=
# Per request, not per operation: the CX portal is slow and chains several
# requests per action.
BSCS_TIMEOUT=45
# The portal is plain HTTP, so there is no certificate to verify. Set this only
# if it is moved behind HTTPS. Credentials are sent in cleartext over HTTP --
# acceptable only on the internal network.
BSCS_VERIFY_SSL=true
# Caps rows returned by a search so a broad query cannot pull a large slice of
# the customer index into memory or into a log.
BSCS_MAX_RESULTS=25

# --------------------------------------------------------
# AUTOMATED SUSPENSION
# --------------------------------------------------------
# Nightly job that suspends hosting accounts whose web-hosting billing has
# lapsed, replacing the manual pass. See scripts/suspend_expired.py and
# suspension.py.
#
#   report only (default):  ./venv/bin/python scripts/suspend_expired.py
#   actually suspend:       ./venv/bin/python scripts/suspend_expired.py --live
#
# It only ever suspends an account that is currently NOT suspended, and only
# on positive confirmation from BSCS. An account already suspended for a
# non-billing reason (abuse, spam, bandwidth) is never touched, so that reason
# is preserved. It never unsuspends.
#
# The job is deliberately dry-run by default: --live is required to act.
# DirectAdmin requires DIRECTADMIN_API_PASSWORD (see above) to be set, without
# which the job refuses to run rather than skipping that panel.
#
# Separate from the surrender audit because the record shapes differ.
SUSPENSION_AUDIT_LOG=./suspension/audit.jsonl

# --------------------------------------------------------
# nic.bt.bt REGISTRY FIELD DEFAULTS
# --------------------------------------------------------
# The registry's domain form requires 23 fields, and it follows the
# international convention, confirmed against real records on the portal:
#
#   tech_*    = the DOMAIN OWNER. On every record sampled, tech_email was
#               identical to the registrant's own email.
#   billing_* = the REGISTRAR or its billing agent. Those records carried the
#               agent's details there, not the customer's.
#
# So Bhutan Telecom's own values belong in the BILLING block below. The
# technical block is derived from the customer automatically. Do not put BT
# details in tech_* -- doing so publishes Bhutan Telecom as the technical
# contact for every customer domain, which is wrong for any domain whose owner
# manages their own DNS. That was the original behaviour, and it was wrong.
#
# The dashboard's "Registry details" panel lists all 23 fields before you
# submit, and lets you override any of these per registration.
#
# These values are still unconfirmed with the registry; they were guesses
# inherited from the original implementation.
NIC_REGISTRAR=DrukNet
NIC_BILLING_NAME=Bhutan Telecom Ltd
NIC_BILLING_ADDRESS=Thimphu, Bhutan
NIC_BILLING_CONTACT=+975-2-343434
NIC_BILLING_FAX=-
NIC_BILLING_COUNTRY=BT
NIC_BILLING_EMAIL=systems@bt.bt
# Used where the registry marks a field required but there is no real value.
# Real records on the registry use "-" in these positions.
NIC_PLACEHOLDER=-
NIC_DEFAULT_COUNTRY=BT
